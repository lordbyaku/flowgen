# Konfigurasi web Firebase (bukan rahasia, tetapi batasi domain di console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# reCAPTCHA v3 site key untuk App Check
VITE_APPCHECK_SITE_KEY=
# Hanya dev
VITE_APPCHECK_DEBUG_TOKEN=
# true = sambungkan ke Firebase Emulator (auth 9099, firestore 8080)
VITE_USE_EMULATORS=false
# true = Mode Demo Lokal (tanpa Firebase; data project di IndexedDB browser ini)
VITE_DEMO_MODE=false
# JANGAN taruh API key Gemini di sini. Key hanya dimasukkan lewat UI.
